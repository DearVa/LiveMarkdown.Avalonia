<UserControl
  x:Class="LiveMarkdown.Avalonia.Demo.Views.HooksDemoView" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia">
  <UserControl.Styles>
    <Style Selector="md|Link.hook-link">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.hook-heading">
      <Setter Property="BorderBrush" Value="#3B82F6"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="0,0,0,8"/>
    </Style>
    <Style Selector="md|CodeBlock.hook-code /template/ StackPanel > Border">
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel
      MaxWidth="1100" Margin="24"
      HorizontalAlignment="Stretch" Spacing="20">
      <StackPanel Spacing="8">
        <TextBlock
          FontSize="28" FontWeight="SemiBold"
          Text="Small hooks. Visible effects."/>
        <TextBlock
          Opacity="0.75" Text="Switch scopes, stream an update, then dispose the hooks. Watch initialization and cleanup follow node lifetimes."
          TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Orientation="Horizontal">
        <CheckBox
          x:Name="LocalHooksToggle" Margin="0,0,20,10"
          Content="Local link + code hooks" IsChecked="True"
          IsCheckedChanged="HandleHookSettingsChanged"/>
        <CheckBox
          x:Name="GlobalHooksToggle" Margin="0,0,20,10"
          Content="Global heading hook" IsCheckedChanged="HandleHookSettingsChanged"/>
        <Button
          Margin="0,0,8,10" Click="HandleStream"
          Content="Stream update"/>
        <Button
          Classes="Outline" Margin="0,0,8,10"
          Click="HandleReset" Content="Reset"/>
        <Button
          Classes="Ghost" Margin="0,0,8,10"
          Click="HandleClearLog" Content="Clear log"/>
      </WrapPanel>
      <TextBlock
        x:Name="LifecycleCounts" FontFamily="Consolas, monospace"
        TextWrapping="Wrap"/>
      <Grid
        x:Name="PlaygroundGrid" ColumnDefinitions="3*,24,2*"
        RowDefinitions="Auto,Auto">
        <StackPanel Spacing="16">
          <TextBlock
            FontSize="11" FontWeight="Bold"
            Opacity="0.6" Text="LOCAL + GLOBAL"/>
          <md:MarkdownRenderer x:Name="PrimaryRenderer"/>
          <Expander
            HorizontalAlignment="Stretch" Header="Source and registration example">
            <StackPanel
              Margin="0,12" Spacing="12">
              <SelectableTextBlock
                x:Name="SourceText" FontFamily="Consolas, monospace"
                TextWrapping="Wrap"/>
              <md:MarkdownRenderer x:Name="ApiRenderer"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel
          x:Name="ComparisonPanel" Grid.Row="0"
          Grid.Column="2" Spacing="16">
          <TextBlock
            FontSize="11" FontWeight="Bold"
            Opacity="0.6" Text="GLOBAL ONLY · SECOND RENDERER"/>
          <md:MarkdownRenderer x:Name="SecondaryRenderer"/>
          <Border
            Padding="0,16,0,0"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <TextBlock
                FontSize="11" FontWeight="Bold"
                Opacity="0.6" Text="LIFECYCLE LOG"/>
              <TextBox
                x:Name="LifecycleLog" MinHeight="220"
                MaxHeight="360" AcceptsReturn="True"
                FontFamily="Consolas, monospace" FontSize="12"
                IsReadOnly="True" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <TextBlock
        Opacity="0.65" Text="The local hook adds the trailing arrow, not the site icon. The before/after pair removes and restores the arrow around indexed content synchronization; the label stays selectable."
        TextWrapping="Wrap"/>
      <TextBlock
        x:Name="LinkStatus" Opacity="0.75"
        TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
